PORT=3001
NODE_ENV=development

# Redis (optional — falls back to in-memory for single instance)
# REQUIRED for multi-instance deployments behind a load balancer
REDIS_URL=redis://localhost:6379

# API Keys — JSON array of key objects
# In production, load from a secrets manager
PULSE_API_KEYS=[{"key":"sk_live_demo123","name":"Demo App","tier":"starter","rateLimit":1000,"webhookUrl":""}]

# HMAC secret for signing challenge nonces (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_CHALLENGE_SECRET=

# HMAC secret for signing webhook payloads (min 32 chars)
WEBHOOK_SECRET=

# Nonce TTL in seconds
NONCE_TTL=300

# Maximum outstanding nonces (prevents hoarding attacks)
MAX_OUTSTANDING_NONCES=10000

# CORS — comma-separated origins, or * for open
CORS_ORIGINS=*
