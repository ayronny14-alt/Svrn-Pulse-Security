# Dependencies
node_modules/
package-lock.json
.pnp
.pnp.js

# Build output
dist/

# Compiled WASM artifacts (wasm-pack generates pkg/ from Rust source)
# pkg/pulse_core.js is source — tracked above; only exclude compiled binaries
pkg/*.wasm
pkg/package.json
pkg/.gitignore

# Rust/WASM build artifacts
crates/*/target/
target/

# Environment files — never commit secrets
.env
.env.local
.env.production
server/.env
.npmrc

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Test coverage
coverage/
.nyc_output/

# Temp
tmp/
temp/
